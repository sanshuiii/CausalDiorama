# source this file before running bin/*.py or generation/*.py (never commit a real key)
export ANTHROPIC_API_KEY=sk-ant-...            # required
export CD_AGENT_MODE=api                       # api (Messages API, Claude Code subagent replica) | claude_cli (one `claude -p` per agent task)
# export CLAUDE_CLI=claude                     # the Claude Code executable for CD_AGENT_MODE=claude_cli
# export CD_LLM_MESSAGES_URL=https://api.anthropic.com/v1/messages   # default; a compatible endpoint also works
# export CD_LLM_AUTH=x-api-key                 # or: bearer (endpoints that expect "Authorization: Bearer")
# export LLM_MODEL=claude-opus-5-5             # default
# export LLM_MAX_CONCURRENCY=8                 # agents per run
